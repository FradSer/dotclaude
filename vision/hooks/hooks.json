{
  "description": "Vision Bridge UserPromptSubmit hook: auto-describe image file paths in the prompt",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bridge_file_paths.py"
          }
        ]
      }
    ]
  }
}

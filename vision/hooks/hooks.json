{
  "description": "Vision Bridge hooks: auto-describe image file paths (UserPromptSubmit) and keep the screenshot-bridging proxy running (SessionStart)",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/bridge_file_paths.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/ensure_proxy.py"
          }
        ]
      }
    ]
  }
}

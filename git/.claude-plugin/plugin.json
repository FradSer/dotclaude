{
  "name": "git",
  "displayName": "Git",
  "version": "0.6.1",
  "description": "Conventional Git automation, advanced repository management, and GitFlow workflow automation for feature, hotfix, and release branches with post-finish cleanup",
  "author": {
    "name": "Frad LEE",
    "email": "fradser@gmail.com"
  },
  "license": "MIT",
  "keywords": [
    "git",
    "conventional-commits",
    "automation",
    "workflow",
    "version-control",
    "gitflow"
  ],
  "commands": [
    "./skills/commit/",
    "./skills/commit-and-push/",
    "./skills/start-feature/",
    "./skills/finish-feature/",
    "./skills/start-hotfix/",
    "./skills/finish-hotfix/",
    "./skills/start-release/",
    "./skills/finish-release/"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/validate-commit-pretool.sh"
          }
        ]
      }
    ]
  }
}
